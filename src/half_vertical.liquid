<div class="layout mf-layout">
  <div class="mf mf--half_vertical w--full h--full bg--black text--white" data-view="half_vertical" {{ mf_attrs }}>
    <div class="mf-hero"><canvas class="mf-cv absolute"></canvas></div>
    <canvas class="mf-sky absolute top--0 left--0"></canvas>
    <div class="mf-corners">
      <div class="mf-c mf-tl flex flex--col gap--none flex--left"><span class="description lg:description--large lg:text--regular text--white" data-mf="a1"></span><span class="mf-v text--large lg:text--xlarge text--bold text--white" data-mf="a2"></span><span class="mf-s description lg:description--large lg:text--regular text--white" data-mf="a3"></span></div>
      <div class="mf-c mf-tr flex flex--col gap--none flex--right text--right"><span class="description lg:description--large lg:text--regular text--white" data-mf="b1"></span><span class="mf-v text--large lg:text--xlarge text--bold text--white" data-mf="b2"></span><span class="mf-s description lg:description--large lg:text--regular text--white" data-mf="b3"></span></div>
      <div class="mf-c mf-bl flex flex--col gap--none flex--left"><span class="description lg:description--large lg:text--regular text--white" data-mf="c1"></span><span class="mf-v text--large lg:text--xlarge text--bold text--white" data-mf="c2"></span><span class="mf-s description lg:description--large lg:text--regular text--white" data-mf="c3"></span></div>
      <div class="mf-c mf-br flex flex--col gap--none flex--right text--right"><span class="description lg:description--large lg:text--regular text--white" data-mf="d1"></span><span class="mf-v mf-v--names text--base lg:text--large text--bold text--white" data-mf="d2"></span><span class="mf-s description lg:description--large lg:text--regular text--white" data-mf="d3"></span></div>
    </div>
  </div>
</div>
